# Salin ke .env lalu isi. Jangan commit .env.
DATABASE_URL=postgres://pmess:pmess@postgres:5432/pmess?sslmode=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://chat.example.com/api/auth/google/callback
DEVELOPER_EMAIL=you@example.com
ALLOWED_ORIGINS=https://chat.example.com
COOKIE_SECURE=true
LISTEN_ADDR=:8080
# IP peer yang dipercaya untuk header X-Real-IP (alamat Nginx dilihat dari container).
TRUSTED_PROXY=127.0.0.1
# Hanya untuk test E2E lokal. JANGAN PERNAH set 1 di produksi.
E2E_FAKE_LOGIN=0
