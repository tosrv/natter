# Salin ke .env lalu isi. Jangan commit .env.
# Password Postgres (wajib untuk docker compose; DATABASE_URL app dibangun darinya).
POSTGRES_PASSWORD=ganti-dengan-password-acak
# DATABASE_URL hanya dipakai saat menjalankan server di luar compose (go run).
# DATABASE_URL=postgres://pmess:PASSWORD@localhost:5432/pmess?sslmode=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://chat.example.com/api/auth/google/callback
DEVELOPER_EMAIL=you@example.com
ALLOWED_ORIGINS=https://chat.example.com
COOKIE_SECURE=true
LISTEN_ADDR=:8080
# IP peer yang dipercaya untuk header X-Real-IP. Di compose default 172.28.0.1
# (gateway subnet tetap 172.28.0.0/16 = Nginx di host). Untuk go run lokal: 127.0.0.1.
TRUSTED_PROXY=172.28.0.1
# Hanya untuk test E2E lokal. JANGAN PERNAH set 1 di produksi
# (server menolak start bila E2E_FAKE_LOGIN=1 dan COOKIE_SECURE=true).
E2E_FAKE_LOGIN=0
